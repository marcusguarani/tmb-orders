# ============================================================
#  TMB Orders - variáveis de ambiente
#  Copie este arquivo para ".env" e ajuste as senhas.
#  O arquivo .env NÃO é versionado (está no .gitignore).
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

# ---------- PostgreSQL ----------
POSTGRES_DB=tmb_orders
POSTGRES_USER=tmb
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# ---------- pgAdmin (interface de administração do banco) ----------
PGADMIN_EMAIL=admin@tmborders.com
PGADMIN_PASSWORD=troque-esta-senha
PGADMIN_PORT=5050

# ---------- RabbitMQ ----------
RABBITMQ_USER=tmb
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Serviços .NET ----------
API_PORT=5080
WORKER_PORT=5081

# ---------- Jaeger (tracing) ----------
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317

# ---------- Módulo de IA (opcional) ----------
# Qualquer provedor com API compatível com a OpenAI. Escolha UMA das opções abaixo.
# Deixe AI_MODEL vazio para desativar o módulo. Confira no site do provedor o nome atual do modelo.
#
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4.1-mini
# Google Gemini (tem cota gratuita - chave em https://aistudio.google.com):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
# Groq (tem cota gratuita - chave em https://console.groq.com):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# Ollama local (sem chave e sem custo - rode: ollama pull qwen2.5:7b):
#   AI_BASE_URL=http://host.docker.internal:11434/v1
#   AI_MODEL=qwen2.5:7b
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# ---------- Frontend ----------
FRONTEND_PORT=3000
